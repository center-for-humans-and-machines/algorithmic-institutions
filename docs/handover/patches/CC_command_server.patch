index 93d8e7c..0815e21 100644
--- a/tests/cc_command_server/test_algoinst_raven.py
+++ b/tests/cc_command_server/test_algoinst_raven.py
@@ -237,3 +237,27 @@ class TestSnapshotConfig:
 
         with pytest.raises(RuntimeError, match="3650"):
             get_snapshot_max_age_days()
+
+
+def test_raven_user_comes_from_cc_raven_user(monkeypatch):
+    """Another Raven user's paths follow CC_RAVEN_USER (set by the proxy's compose)."""
+    import importlib
+
+    import CC_command_server.constants as constants
+
+    monkeypatch.setenv("CC_RAVEN_USER", "someone")
+    try:
+        importlib.reload(constants)
+        assert constants.RAVEN_USER == "someone"
+        assert constants.RAVEN_CC_SNAPSHOTS == "/u/someone/cc-snapshots"
+        assert constants.RAVEN_ALGOINST_CONTAINER_PATH == (
+            "/raven/ptmp/someone/cc/containers/apptainer/algoinst.sif"
+        )
+        assert "--env-file /u/someone/private/cc_secrets" in (
+            constants.RAVEN_ALGOINST_CONTAINER_EXEC
+        )
+        assert "ykeller" not in constants.RAVEN_ALGOINST_CONTAINER_EXEC
+        assert constants.RAVEN_ALGOINST_SLURM_TEMPLATE_PATH.startswith("/u/someone/")
+    finally:
+        monkeypatch.delenv("CC_RAVEN_USER")
+        importlib.reload(constants)
