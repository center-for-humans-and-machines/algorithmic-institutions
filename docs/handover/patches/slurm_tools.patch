+def test_raven_algoinst_template_has_no_fixed_user(tmp_path, monkeypatch):
+    """Every Raven user can run the template: paths come from $USER and $HOME."""
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.chdir(tmp_path)
+    parser = obtain_parser()
+    args = parser.parse_args(
+        [
+            "--dry", "--skip_program_file_check",
+            "--program_call", "-m aimanager simulate configs/x.yml",
+            "--template_file", RAVEN,
+            "--run_group", "g",
+            "--image", "/raven/ptmp/someone/cc/containers/apptainer/algoinst.sif",
+            "--checkout", "b" * 40,
+            "--launcher", "python",
+        ]
+    )
+    slurm_job(**vars(args))
+    text = next((tmp_path / "runs" / "g").glob("*/slurm_script.sh")).read_text()
+    assert "ykeller" not in text
+    assert "--env-file $HOME/private/cc_secrets" in text
+    for d in ("tmp", "container_outputs", "cluster_transfer", "cluster_sync", "apptainer-home"):
+        assert f"$CC_PTMP/{d}" in text.split("srun", 1)[0], d
