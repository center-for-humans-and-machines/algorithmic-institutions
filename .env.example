# For the manual SSH path of the AH and simulation runs (kept to reproduce
# them): scripts/artificial_humans/run_training.sh sources .env;
# train_cluster.sh and simulate_cluster.sh copy it to Raven. The Claude proxy
# and the policy finder do not read this file: their settings are
# infra/claude_proxy/container/CC_env/.env (see .env.example there).
ANTHROPIC_API_KEY=anthropic_api_key
WANDB_API_KEY=your_wandb_api_key
WANDB_ENTITY=chm-ml
WANDB_PROJECT=algorithmic-institutions
