{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "lsp": false,
  "formatter": false,
  "enabled_providers": ["openrouter"],
  "permission": {
    "*": "deny",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "edit": "allow",
    "bash": "allow",
    "todowrite": "allow",
    "invalid": "allow",
    "external_directory": {"*": "deny", "/tmp/*": "allow"},
    "doom_loop": "deny"
  }
}
