# Settings for the Claude proxy and the policy finder.
# Copy to .env (gitignored) in this folder, beside docker-compose.yml, and
# fill in. Not the .env.example at the repo root: that one is for the manual
# SSH path and the proxy never reads it.
# Compose reads it from this folder. Paths must be absolute.

# Your MPCDF login. Required: compose refuses to start without it.
RAVEN_USER=

# Your host uid and gid (`id -u`, `id -g`; usually 501 and 20 on a Mac).
# The proxy and the agents run as this user. If not 1000, also change `user:` in
# infra/claude_proxy/container/spawner_config/algoinst.yml to match.
HOST_UID=1000
HOST_GID=1000

# Author of the commits the pipeline makes in the proxy (instance branches).
GIT_USER_NAME="Claude Code"
GIT_USER_EMAIL=

# Defaults, shown here. Uncomment to change.
# Clones of github.com/yannikkellerde/CC_command_server and .../container_spawner:
#   $CLAUDE_TOOLS/CC_command_server, $CLAUDE_TOOLS/container_spawner
# CLAUDE_TOOLS=${HOME}/claude_tools
# Secrets layout: infra/claude_proxy/secrets.example/README.md
# SECRETS_DIR=${HOME}/secrets
# Logs, cluster transfers, spawner run homes: cc_logs/, cluster_transfer/, container_spawner/
# CC_STATE_DIR=${HOME}/tmp
# Policy-finder worktrees, exports and locks. Mounted at this same path inside.
# PF_RUNS=${HOME}/pf_runs
